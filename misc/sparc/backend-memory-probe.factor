USING: eval vocabs vocabs.loader ;
"system" reload
"compiler.constants" reload
"compiler.codegen.relocation" reload
"cpu.sparc" require
"USING: accessors alien.c-types arrays byte-arrays command-line compiler.codegen compiler.codegen.relocation cpu.architecture cpu.sparc cpu.sparc.assembler endian io.encodings.ascii io.encodings.binary io.files io.pathnames kernel layouts locals math namespaces prettyprint sequences ;\nQUALIFIED: alien.c-types\nIN: sparc.memory.probe\n:: emit-access ( name width signed? fp? store? -- )\n bootstrap-cell 8 = :> wide?\n wide? 176 96 ? :> frame\n fp? [ width 4 = float-rep double-rep ? ] [ int-rep ] if :> rep\n fp? [ f ] [ width { { 1 [ signed? alien.c-types:char alien.c-types:uchar ? ] }\n         { 2 [ signed? alien.c-types:short alien.c-types:ushort ? ] }\n         { 4 [ signed? alien.c-types:int alien.c-types:uint ? ] }\n         [ drop f ] } case ] if :> type\n [ frame %prologue\n   fp? [\n    store? [\n     wide? [ width 4 = [ 0 3 FMOVS ] [ 0 2 FMOVD ] if ] [\n      25 sp-reg 80 ST width 8 = [ 26 sp-reg 84 ST ] when\n      width 4 = [ 0 sp-reg 80 LDF ] [ 0 sp-reg 80 LDDF ] if\n     ] if\n     0 24 0 rep type %store-memory-imm\n    ] [ 0 24 0 rep type %load-memory-imm ] if\n   ] [ width 8 = wide? not and [\n     store? [ 25 24 0 int-rep alien.c-types:uint %store-memory-imm\n              26 24 4 int-rep alien.c-types:uint %store-memory-imm ]\n            [ 25 24 4 int-rep alien.c-types:uint %load-memory-imm\n              24 24 0 int-rep alien.c-types:uint %load-memory-imm ] if\n    ] [ store? [ 25 24 0 rep type %store-memory-imm ]\n               [ 24 24 0 rep type %load-memory-imm ] if ] if\n   ] if\n   frame %epilogue %return\n ] with-fixup :> result\n command-line get first name append-path :> path\n result 4 swap nth path binary set-file-contents\n result 3 swap nth unparse path \".labels\" append ascii set-file-contents ;\n{ sparc.32 sparc.64 } [| target |\n target \\ cpu [ target sparc.32? 4 8 ? \\ cell [\n big-endian relocation-byte-order set\n { { \"u8\" 1 f f } { \"s8\" 1 t f } { \"u16\" 2 f f } { \"s16\" 2 t f }\n   { \"u32\" 4 f f } { \"s32\" 4 t f } { \"u64\" 8 f f } { \"s64\" 8 t f }\n   { \"cell\" 0 f f } { \"float\" 4 f t } { \"double\" 8 f t } }\n [| item |\n item first :> stem item second dup zero? [ drop bootstrap-cell ] when :> width\n { f t } [| store? |\n stem store? \"-store\" \"-load\" ? append target sparc.32? \"32.bin\" \"64.bin\" ? append\n width item third item fourth store? emit-access\n ] each ] each\n ] with-variable ] with-variable\n] each\n" eval( -- )
