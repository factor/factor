@@ -132,7 +132,22 @@ crb_write(long channel, unsigned long length, const char *buf,
 unsigned long
 crb_get_env(unsigned long id, char *buf, unsigned long length)
 {
-  /* FIXME */
+  /* SRM tty_dev selects the single COM1 console implemented above.  */
+  if (id == 0xf && length != 0) {
+    buf[0] = '0';
+    return 1;
+  }
+#ifdef SRM_BOOT_FLAGS
+  if (id == 0x8) {
+    const char *flags = SRM_BOOT_FLAGS;
+    unsigned long n = 0;
+    while (flags[n] && n < length) {
+      buf[n] = flags[n];
+      ++n;
+    }
+    return n;
+  }
+#endif
