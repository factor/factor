+const uint32_t *M88kRegisterInfo::getCustomEHPadPreservedMask(
+    const MachineFunction &MF) const {
+  // GNU builtin_longjmp restores FP/SP/PC only. The exceptional edge must
+  // clobber registers at block entry, before an allocator can spill them.
+  static const std::vector<uint32_t> Mask = [] {
+    std::vector<uint32_t> Result(MachineOperand::getRegMaskSize(M88k::NUM_TARGET_REGS), 0);
+    for (unsigned R : {M88k::R0, M88k::R28, M88k::R29, M88k::R30, M88k::R31, M88k::X0})
+      Result[R / 32] |= 1u << (R % 32);
+    return Result;
+  }();
+  return Mask.data();
+}
