diff --git a/llvm/lib/Target/M88k/M88kSjLjEH.cpp b/llvm/lib/Target/M88k/M88kSjLjEH.cpp
new file mode 100644
index 000000000..1cd4f0769
--- /dev/null
+++ b/llvm/lib/Target/M88k/M88kSjLjEH.cpp
@@ -0,0 +1,145 @@
+//===-- M88kSjLjEH.cpp - GlobalISel SjLj lowering ------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+// GNU builtin-setjmp SjLj context ABI: prefix32, then saved FP/PC/SP words.
+#include "M88k.h"
+#include "M88kSubtarget.h"
+#include "MCTargetDesc/M88kBaseInfo.h"
+#include "llvm/CodeGen/GlobalISel/GenericMachineInstrs.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunctionPass.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/Intrinsics.h"
+#include "llvm/MC/MCContext.h"
+using namespace llvm;
+namespace {
+class M88kSjLjEH : public MachineFunctionPass {
+public:
+  static char ID;
+  M88kSjLjEH() : MachineFunctionPass(ID) {}
+  StringRef getPassName() const override { return "M88k SjLj lowering"; }
+  bool runOnMachineFunction(MachineFunction &MF) override {
+    auto &MRI = MF.getRegInfo();
+    auto &MFI = MF.getFrameInfo();
+    const auto &TII = *MF.getSubtarget<M88kSubtarget>().getInstrInfo();
+    MachineInstr *Setup = nullptr;
+    int FI = 0;
+    SmallVector<MachineInstr *, 8> Erase;
+    SmallVector<MachineInstr *, 4> LSDAs;
+    for (auto &BB : MF) for (auto &MI : BB) {
+      if (MI.getOpcode() != TargetOpcode::G_INTRINSIC &&
+          MI.getOpcode() != TargetOpcode::G_INTRINSIC_W_SIDE_EFFECTS) continue;
+      switch (cast<GIntrinsic>(MI).getIntrinsicID()) {
+      case Intrinsic::eh_sjlj_setup_dispatch: Setup = &MI; Erase.push_back(&MI); break;
+      case Intrinsic::eh_sjlj_functioncontext: {
+        auto *Def = MRI.getVRegDef(MI.getOperand(1).getReg());
+        if (!Def || Def->getOpcode() != TargetOpcode::G_FRAME_INDEX)
+          report_fatal_error("SjLj function context must be a static alloca");
+        FI = Def->getOperand(1).getIndex();
+        MFI.setFunctionContextIndex(FI);
+        Erase.push_back(&MI); break;
+      }
+      case Intrinsic::eh_sjlj_callsite: Erase.push_back(&MI); break;
+      case Intrinsic::eh_sjlj_lsda: LSDAs.push_back(&MI); break;
+      default: break;
+      }
+    }
+    if (!Setup) return false;
+    auto NewReg = [&]() { return MRI.createVirtualRegister(&M88k::GPRRegClass); };
+    auto Address = [&](MachineBasicBlock &BB, MachineBasicBlock::iterator Pos,
+                       Register Dest, const MachineOperand &Sym) {
+      auto Hi = NewReg();
+      auto H = BuildMI(BB, Pos, DebugLoc(), TII.get(M88k::ORriu), Hi).addReg(M88k::R0);
+      auto L = BuildMI(BB, Pos, DebugLoc(), TII.get(M88k::ORri), Dest).addReg(Hi);
+      MachineOperand HSym = Sym, LSym = Sym;
+      HSym.setTargetFlags(M88kII::MO_ABS_HI);
+      LSym.setTargetFlags(M88kII::MO_ABS_LO);
+      H.add(HSym); L.add(LSym);
+    };
+    for (auto *MI : LSDAs) {
+      Register Dst = MI->getOperand(0).getReg();
+      MRI.setRegClass(Dst, &M88k::GPRRegClass);
+      auto *Sym = MF.getContext().getOrCreateSymbol(Twine("GCC_except_table") + Twine(MF.getFunctionNumber()));
+      Address(*MI->getParent(), MI->getIterator(), Dst, MachineOperand::CreateMCSymbol(Sym));
+      Erase.push_back(MI);
+    }
+    // SjLjEHPrepare numbers invokes in IR block order, starting at one.
+    SmallVector<MachineBasicBlock *, 8> Pads;
+    unsigned Site = 0;
+    for (auto &BB : MF.getFunction()) {
+      auto *Invoke = dyn_cast<InvokeInst>(BB.getTerminator());
+      if (!Invoke) continue;
+      ++Site;
+      MachineBasicBlock *InvokeBB = nullptr, *Pad = nullptr;
+      for (auto &MBB : MF) {
+        if (MBB.getBasicBlock() == &BB) InvokeBB = &MBB;
+        if (MBB.getBasicBlock() == Invoke->getUnwindDest()) Pad = &MBB;
+      }
+      if (!InvokeBB || !Pad) report_fatal_error("Missing SjLj invoke blocks");
+      MCSymbol *PadSym = nullptr;
+      for (auto &MI : *Pad) if (MI.isEHLabel()) { PadSym = MI.getOperand(0).getMCSymbol(); break; }
+      if (!PadSym) {
+        PadSym = MF.addLandingPad(Pad);
+        BuildMI(*Pad, Pad->begin(), DebugLoc(), TII.get(TargetOpcode::EH_LABEL)).addSym(PadSym);
+      }
+      MF.setCallSiteLandingPad(PadSym, {Site});
+      bool Region = false;
+      for (auto &MI : *InvokeBB) {
+        if (MI.getOpcode() == TargetOpcode::G_INVOKE_REGION_START) Region = true;
+        else if (Region && MI.isEHLabel()) {
+          MF.setCallSiteBeginLabel(MI.getOperand(0).getMCSymbol(), Site);
+          break;
+        }
+      }
+      Pads.push_back(Pad);
+    }
+    SmallVector<MachineBasicBlock *, 32> OriginalBlocks;
+    for (auto &BB : MF) OriginalBlocks.push_back(&BB);
+    auto *Dispatch = MF.CreateMachineBasicBlock();
+    MF.push_back(Dispatch);
+    Dispatch->setIsEHPad();
+    Dispatch->setMachineBlockAddressTaken();
+    auto Addr = NewReg();
+    Address(*Setup->getParent(), Setup->getIterator(), Addr, MachineOperand::CreateMBB(Dispatch));
+    BuildMI(*Setup->getParent(), *Setup, DebugLoc(), TII.get(M88k::STriw))
+      .addReg(Addr).addFrameIndex(FI).addImm(36);
+    // Register the exceptional-edge clobbers for callee-save accounting.
+    const auto &TRI = *MF.getSubtarget().getRegisterInfo();
+    MRI.addPhysRegsUsedFromRegMask(TRI.getCustomEHPadPreservedMask(MF));
+    auto CallSite = NewReg();
+    BuildMI(*Dispatch, Dispatch->end(), DebugLoc(), TII.get(M88k::LDriw), CallSite).addFrameIndex(FI).addImm(4);
+    auto *Test = Dispatch;
+    for (unsigned I = 0; I < Pads.size(); ++I) {
+      auto *Next = MF.CreateMachineBasicBlock();
+      MF.push_back(Next);
+      auto Cmp = NewReg();
+      BuildMI(*Test, Test->end(), DebugLoc(), TII.get(M88k::CMPri), Cmp).addReg(CallSite).addImm(I);
+      BuildMI(*Test, Test->end(), DebugLoc(), TII.get(M88k::BB1)).addImm(2).addReg(Cmp).addMBB(Pads[I]);
+      BuildMI(*Test, Test->end(), DebugLoc(), TII.get(M88k::BR)).addMBB(Next);
+      Test->addSuccessor(Pads[I]);
+      Test->addSuccessor(Next);
+      Test = Next;
+    }
+    BuildMI(*Test, Test->end(), DebugLoc(), TII.get(M88k::BR)).addMBB(Test);
+    Test->addSuccessor(Test);
+    // Preserve exceptional CFG reachability but route every invoke to dispatch.
+    for (auto *BB : OriginalBlocks) {
+      SmallVector<MachineBasicBlock *, 4> Old;
+      for (auto *Succ : BB->successors()) if (Succ->isEHPad()) Old.push_back(Succ);
+      if (Old.empty()) continue;
+      for (auto *Succ : Old) BB->removeSuccessor(Succ);
+      BB->addSuccessor(Dispatch);
+    }
+    for (auto *MI : Erase) MI->eraseFromParent();
+    return true;
+  }
+};
+char M88kSjLjEH::ID;
+}
+FunctionPass *llvm::createM88kSjLjEH() { return new M88kSjLjEH(); }
