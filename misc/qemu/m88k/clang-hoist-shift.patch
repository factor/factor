+bool M88kPreLegalizerCombinerImpl::matchM88kHoistLogic(
+    MachineInstr &MI, InstructionStepsMatchInfo &Info) const {
+  // commute_shift distributes (x | C1) << C2 into two shifts. Let the
+  // constant shift fold before hoisting; otherwise these rules undo each
+  // other indefinitely as each rewrite creates fresh virtual registers.
+  for (unsigned Op : {1u, 2u}) {
+    MachineInstr *Hand = getDefIgnoringCopies(MI.getOperand(Op).getReg(), MRI);
+    if (Hand && Hand->getOpcode() == TargetOpcode::G_SHL &&
+        getIConstantVRegValWithLookThrough(Hand->getOperand(1).getReg(), MRI) &&
+        getIConstantVRegValWithLookThrough(Hand->getOperand(2).getReg(), MRI))
+      return false;
+  }
+  return Helper.matchHoistLogicOpWithSameOpcodeHands(MI, Info);
+}
+
