+bool M88kInstructionSelector::selectFCmp(MachineInstr &I,
+                                        MachineBasicBlock &MBB,
+                                        MachineRegisterInfo &MRI) const {
+  unsigned Bit;
+  bool Invert = false;
+  switch (I.getOperand(1).getPredicate()) {
+  case CmpInst::FCMP_UNO: Bit = 0; break;
+  case CmpInst::FCMP_ORD: Bit = 1; break;
+  case CmpInst::FCMP_OEQ: Bit = 2; break;
+  case CmpInst::FCMP_ONE: Bit = 3; break;
+  case CmpInst::FCMP_OGT: Bit = 4; break;
+  case CmpInst::FCMP_OLE: Bit = 5; break;
+  case CmpInst::FCMP_OLT: Bit = 6; break;
+  case CmpInst::FCMP_OGE: Bit = 7; break;
+  case CmpInst::FCMP_UEQ: Bit = 3; Invert = true; break;
+  case CmpInst::FCMP_UNE: Bit = 2; Invert = true; break;
+  case CmpInst::FCMP_UGT: Bit = 5; Invert = true; break;
+  case CmpInst::FCMP_UGE: Bit = 6; Invert = true; break;
+  case CmpInst::FCMP_ULT: Bit = 7; Invert = true; break;
+  case CmpInst::FCMP_ULE: Bit = 4; Invert = true; break;
+  default: return false;
+  }
+  Register Dst = I.getOperand(0).getReg();
+  Register LHS = I.getOperand(2).getReg();
+  Register RHS = I.getOperand(3).getReg();
+  unsigned Bits = MRI.getType(LHS).getSizeInBits();
+  if (Bits != 32 && Bits != 64) return false;
+  Register Flags = MRI.createVirtualRegister(&M88k::GPRRegClass);
+  auto Compare = BuildMI(MBB, I, I.getDebugLoc(),
+                         TII.get(Bits == 64 ? M88k::FCMPgsdd : M88k::FCMPgsss), Flags)
+                     .addReg(LHS).addReg(RHS);
+  if (!constrainSelectedInstRegOperands(*Compare, MRI, TII, TRI, RBI)) return false;
+  Register Result = Invert ? MRI.createVirtualRegister(&M88k::GPRRegClass) : Dst;
+  auto Extract = BuildMI(MBB, I, I.getDebugLoc(), TII.get(M88k::EXTUrwo), Result)
+                     .addReg(Flags).addImm(1).addImm(Bit);
+  if (!constrainSelectedInstRegOperands(*Extract, MRI, TII, TRI, RBI)) return false;
+  if (Invert) {
+    auto Flip = BuildMI(MBB, I, I.getDebugLoc(), TII.get(M88k::XORri), Dst)
+                    .addReg(Result).addImm(1);
+    if (!constrainSelectedInstRegOperands(*Flip, MRI, TII, TRI, RBI)) return false;
+  }
+  I.eraseFromParent();
+  return true;
+}
