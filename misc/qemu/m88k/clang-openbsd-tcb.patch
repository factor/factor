diff --git a/llvm/lib/Target/M88k/M88kRegisterInfo.cpp b/llvm/lib/Target/M88k/M88kRegisterInfo.cpp
--- a/llvm/lib/Target/M88k/M88kRegisterInfo.cpp
+++ b/llvm/lib/Target/M88k/M88kRegisterInfo.cpp
@@ -86,6 +86,11 @@
   if (MF.getSubtarget<M88kSubtarget>().isMC88110())
     Reserved.set(M88k::X0);
 
+  // OpenBSD libc reads the live thread-control-block pointer from r27.
+  // Preserving it only at function return is insufficient across libc calls.
+  if (MF.getTarget().getTargetTriple().isOSOpenBSD())
+    Reserved.set(M88k::R27);
+
   // R28 and R29 are always reserved according to SYS-V ABI.
   Reserved.set(M88k::R28);
   Reserved.set(M88k::R29);
