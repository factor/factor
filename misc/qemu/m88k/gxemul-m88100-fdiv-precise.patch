+/* Reserved operands are completed in supervisor software (6.8.1.1). */
+static int m88k_fdiv_reserved(uint64_t value, int dbl)
+{
+    uint64_t fraction = value & (dbl ? 0xfffffffffffffULL : 0x7fffffULL);
+    unsigned exponent = (value >> (dbl ? 52 : 23)) & (dbl ? 0x7ff : 0xff);
+    return exponent == (dbl ? 0x7ff : 0xff) || (exponent == 0 && fraction != 0);
+}
+
+/* Capture the architected precise-exception operands (MC88100 6.8.1.4-8).
+ * Exception enables other than inexact are interpreted by supervisor software.
+ */
+static void m88k_fdiv_precise_state(struct cpu *cpu,
+    struct m88k_instr_call *ic, uint64_t s1, uint64_t s2,
+    int d1, int d2, int dd)
+{
+    uint64_t src[2] = { s1, s2 };
+    int dbl[2] = { d1, d2 };
+    for (int i = 0; i < 2; i++) {
+        uint32_t hi, lo;
+        if (dbl[i]) {
+            hi = src[i] >> 32;
+            lo = src[i];
+        } else {
+            uint32_t single = src[i];
+            uint32_t exp = (single >> 23) & 0xff;
+            if (exp & 0x80)
+                exp |= 0x700;
+            hi = (single & 0x80000000) | (exp << 20)
+                | ((single & 0x7fffff) >> 3);
+            lo = single << 29;
+        }
+        cpu->cd.m88k.fcr[1 + 2 * i] = hi;
+        cpu->cd.m88k.fcr[2 + 2 * i] = lo;
+    }
+    unsigned rd = ((uint32_t *)ic->arg[0]) - &cpu->cd.m88k.r[0];
+    cpu->cd.m88k.fcr[5] = (0x0e << 11) | (d1 << 9)
+        | (d2 << 7) | (dd << 5) | rd;
+}
