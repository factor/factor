+++ b/llvm/lib/Target/M88k/M88kInstrInfo.td
@@ -938,6 +938,16 @@ let isBranch = 1, isTerminator = 1 in {
   }
 }
 
+// OpenBSD userland full pipeline/memory barrier. Not a control-flow barrier:
+// bit zero of r0 is clear, so this instruction cannot take its trap.
+def MEMBAR : InstM88k<(outs), (ins), "tb1", "0, %r0, 128"> {
+  let Inst = 0xf000d880;
+  let isCodeGenOnly = 1;
+  let hasSideEffects = 1;
+  let mayLoad = 1;
+  let mayStore = 1;
+}
+
 let isTrap = 1, isBarrier = 1 in {
   def TB0 : F_TB<0b1101000, (outs), (ins imm32zx5:$b5, GPROpnd:$rs1, Vec9:$vec9),
                  "tb0">;
