   case TargetOpcode::G_PTRTOINT:
   case TargetOpcode::G_FREEZE:
     return selectCopy(I, TII, MRI, TRI, RBI);
+  case TargetOpcode::G_TRUNC: {
+    Register Dst = I.getOperand(0).getReg();
+    Register Src = I.getOperand(1).getReg();
+    unsigned Bits = MRI.getType(Dst).getSizeInBits();
+    unsigned SrcBits = MRI.getType(Src).getSizeInBits();
+    if ((Bits != 1 && Bits != 8 && Bits != 16 && Bits != 32) ||
+        (SrcBits != 32 && SrcBits != 64))
+      return false;
+    if (!RBI.constrainGenericRegister(Dst, M88k::GPRRegClass, MRI) ||
+        !RBI.constrainGenericRegister(Src, SrcBits == 64 ? M88k::GPR64RegClass
+                                                      : M88k::GPRRegClass, MRI))
+      return false;
+    auto Trunc = BuildMI(MBB, I, I.getDebugLoc(),
+                         TII.get(Bits == 32 ? TargetOpcode::COPY : M88k::MASKri), Dst);
+    Trunc.addReg(Src, 0, SrcBits == 64 ? M88k::sub_lo : 0);
+    if (Bits != 32)
+      Trunc.addImm((1u << Bits) - 1);
+    I.eraseFromParent();
+    return true;
+  }
   case TargetOpcode::G_INTRINSIC:
     return selectIntrinsic(I, MBB, MRI);
