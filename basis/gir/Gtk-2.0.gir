                 filename="gtk+-2.24.33/gtk/gtkdialog.c"
                 line="1259">a #GtkDialog</doc>
            <type name="Dialog" c:type="GtkDialog*"/>
          </instance-parameter>
          <parameter name="first_response_id" transfer-ownership="none">
