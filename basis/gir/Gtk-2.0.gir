            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktreeviewcolumn.c"
                 line="1926">The size to set @tree_column to. Must be greater than 0.</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
