            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkwindow.c"
                 line="3925">a #GtkWindow</doc>
            <type name="Window" c:type="GtkWindow*"/>
          </instance-parameter>
          <parameter name="width" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkwindow.c"
                 line="3926">width in pixels, or -1 to unset the default width</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
          <parameter name="height" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkwindow.c"
                 line="3927">height in pixels, or -1 to unset the default height</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
