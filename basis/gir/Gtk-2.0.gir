                 line="2601">a #GtkTextIter</doc>
            <type name="TextIter" c:type="GtkTextIter*"/>
          </instance-parameter>
          <parameter name="count" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktextiter.c"
                 line="2602">number of lines to move forward</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
