        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk+-2.24.33/gtk/gtktreeview.c"
               line="11291">The number of columns in @tree_view after insertion.</doc>
          <type name="gint" c:type="gint"/>
        </return-value>
        <parameters>
          <instance-parameter name="tree_view" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktreeview.c"
                 line="11282">A #GtkTreeView.</doc>
            <type name="TreeView" c:type="GtkTreeView*"/>
          </instance-parameter>
          <parameter name="column" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktreeview.c"
                 line="11283">The #GtkTreeViewColumn to be inserted.</doc>
