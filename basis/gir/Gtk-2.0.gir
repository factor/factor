                 filename="gtk+-2.24.33/gtk/gtkwidget.c"
                 line="6272">a #GtkWidget</doc>
            <type name="Widget" c:type="GtkWidget*"/>
          </instance-parameter>
          <parameter name="redraw_on_allocate" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkwidget.c"
                 line="6273">if %TRUE, the entire widget will be redrawn
  when it is allocated to a new size. Otherwise, only the
  new portion of the widget will be redrawn.</doc>
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
        </parameters>
