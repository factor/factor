          <instance-parameter name="tree_view" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktreeview.c"
                 line="12670">A #GtkTreeView</doc>
            <type name="TreeView" c:type="GtkTreeView*"/>
          </instance-parameter>
