      <method name="backspace"
              c:identifier="gtk_text_buffer_backspace"
              version="2.6">
        <doc xml:space="preserve"
             filename="gtk+-2.24.33/gtk/gtktextbuffer.c"
             line="3827">Performs the appropriate action as if the user hit the delete
key with the cursor at the position specified by @iter. In the
normal case a single character will be deleted, but when
combining accents are involved, more than one character can
be deleted, and when precomposed character and accent combinations
are involved, less than one character will be deleted.

Because the buffer is modified, all outstanding iterators become
invalid after calling this function; however, the @iter will be
re-initialized to point to the location where text was deleted.</doc>
        <source-position filename="gtk+-2.24.33/gtk/gtktextbuffer.h"
                         line="225"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk+-2.24.33/gtk/gtktextbuffer.c"
               line="3845">%TRUE if the buffer was modified</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="buffer" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktextbuffer.c"
                 line="3829">a #GtkTextBuffer</doc>
            <type name="TextBuffer" c:type="GtkTextBuffer*"/>
          </instance-parameter>
          <parameter name="iter" transfer-ownership="none">
            <doc xml:space="preserve"
