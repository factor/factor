          <parameter name="border_width" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkcontainer.c"
                 line="1128">amount of blank space to leave &lt;emphasis&gt;outside&lt;/emphasis&gt;
  the container. Valid values are in the range 0-65535 pixels.</doc>
            <type name="guint" c:type="guint"/>
          </parameter>
