               filename="gtk+-2.24.33/gtk/gtkvscale.c"
               line="70">a new #GtkVScale.</doc>
          <type name="Widget" c:type="GtkWidget*"/>
        </return-value>
        <parameters>
          <parameter name="adjustment" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkvscale.c"
                 line="66">the #GtkAdjustment which sets the range of the scale.</doc>
