        <parameters>
          <parameter name="socket_id" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkplug.c"
                 line="527">the window ID of the socket, or 0.</doc>
            <type name="Gdk.NativeWindow" c:type="GdkNativeWindow"/>
          </parameter>
        </parameters>
