          </instance-parameter>
          <parameter name="default_widget"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkwindow.c"
                 line="1649">widget to be the default, or %NULL to unset the
                 default widget for the toplevel.</doc>
            <type name="Widget" c:type="GtkWidget*"/>
