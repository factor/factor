               filename="gtk+-2.24.33/gtk/gtkaccelgroup.c"
               line="1286">accelerator keyval</doc>
          <type name="guint" c:type="guint"/>
        </parameter>
        <parameter name="accelerator_mods" transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk+-2.24.33/gtk/gtkaccelgroup.c"
               line="1287">accelerator modifier mask</doc>
