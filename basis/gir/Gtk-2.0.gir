                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkmenu.c"
                 line="1391">the menu shell containing the triggering menu item, or %NULL</doc>
            <type name="Widget" c:type="GtkWidget*"/>
          </parameter>
