                 filename="gtk+-2.24.33/gtk/gtktextlayout.c"
                 line="3522">a #GtkTextIter</doc>
            <type name="TextIter" c:type="GtkTextIter*"/>
          </parameter>
          <parameter name="count" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktextlayout.c"
                 line="3523">number of characters to move (negative moves left, positive moves right)</doc>
