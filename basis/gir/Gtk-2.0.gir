      <method name="insert_column_with_attributes"
              c:identifier="gtk_tree_view_insert_column_with_attributes"
              introspectable="0">
        <doc xml:space="preserve"
             filename="gtk+-2.24.33/gtk/gtktreeview.c"
             line="11344">Creates a new #GtkTreeViewColumn and inserts it into the @tree_view at
@position.  If @position is -1, then the newly created column is inserted at
