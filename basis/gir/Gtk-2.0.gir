      <method name="grab_default" c:identifier="gtk_widget_grab_default">
        <doc xml:space="preserve"
             filename="gtk+-2.24.33/gtk/gtkwidget.c"
             line="5685">Causes @widget to become the default widget. @widget must have the
%GTK_CAN_DEFAULT flag set; typically you have to set this flag
yourself by calling &lt;literal&gt;gtk_widget_set_can_default (@widget,
%TRUE)&lt;/literal&gt;. The default widget is activated when
the user presses Enter in a window. Default widgets must be
activatable, that is, gtk_widget_activate() should affect them.</doc>
        <source-position filename="gtk+-2.24.33/gtk/gtkwidget.h" line="948"/>
        <return-value transfer-ownership="none">
