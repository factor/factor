                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktooltip.c"
                 line="412">a #GtkWidget, or %NULL to unset the old custom widget.</doc>
            <type name="Widget" c:type="GtkWidget*"/>
