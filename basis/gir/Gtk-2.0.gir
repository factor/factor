             line="1877">Creates a copy of @source; mostly useful for language bindings.</doc>
        <source-position filename="gtk+-2.24.33/gtk/gtkiconfactory.h"
                         line="148"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="gtk+-2.24.33/gtk/gtkiconfactory.c"
               line="1883">a new #GtkIconSource</doc>
          <type name="IconSource" c:type="GtkIconSource*"/>
        </return-value>
        <parameters>
          <instance-parameter name="source" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkiconfactory.c"
                 line="1879">a #GtkIconSource</doc>
