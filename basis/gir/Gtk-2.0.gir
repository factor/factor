          <parameter name="startup_id" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkwindow.c"
                 line="1515">a string with startup-notification identifier</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
