                 line="2617">a #GtkStatusIcon</doc>
            <type name="StatusIcon" c:type="GtkStatusIcon*"/>
          </instance-parameter>
          <parameter name="screen"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="none"
                     optional="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkstatusicon.c"
                 line="2618">return location for the screen, or %NULL if the
         information is not needed</doc>
