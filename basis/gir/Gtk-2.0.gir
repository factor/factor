      <method name="forward_cursor_position"
              c:identifier="gtk_text_iter_forward_cursor_position">
        <doc xml:space="preserve"
             filename="gtk+-2.24.33/gtk/gtktextiter.c"
             line="3572">Moves @iter forward by a single cursor position. Cursor positions
are (unsurprisingly) positions where the cursor can appear. Perhaps
surprisingly, there may not be a cursor position between all
characters. The most common example for European languages would be
a carriage return/newline sequence. For some Unicode characters,
the equivalent of say the letter "a" with an accent mark will be
represented as two characters, first the letter then a "combining
mark" that causes the accent to be rendered; so the cursor can't go
between those two characters. See also the #PangoLogAttr structure and
pango_break() function.</doc>
        <source-position filename="gtk+-2.24.33/gtk/gtktextiter.h" line="221"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk+-2.24.33/gtk/gtktextiter.c"
               line="3587">%TRUE if we moved and the new position is dereferenceable</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="iter" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtktextiter.c"
                 line="3574">a #GtkTextIter</doc>
            <type name="TextIter" c:type="GtkTextIter*"/>
          </instance-parameter>
        </parameters>
      </method>
