          <parameter name="requisition" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkwidget.c"
                 line="3938">a #GtkRequisition to be filled in</doc>
            <type name="Requisition" c:type="GtkRequisition*"/>
