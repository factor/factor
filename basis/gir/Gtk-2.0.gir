          <parameter name="setting" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkwindow.c"
                 line="2905">%TRUE to decorate the window</doc>
            <type name="gboolean" c:type="gboolean"/>
