          <parameter name="name" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkuimanager.c"
                 line="1739">the name for the added UI element</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
          <parameter name="action"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk+-2.24.33/gtk/gtkuimanager.c"
                 line="1740">the name of the action to be proxied, or %NULL to add a separator</doc>
            <type name="utf8" c:type="const gchar*"/>
