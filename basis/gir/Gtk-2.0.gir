      <constructor name="new"
                   c:identifier="gtk_recent_manager_new"
                   version="2.10">
        <doc xml:space="preserve"
             filename="gtk+-2.24.33/gtk/gtkrecentmanager.c"
             line="764">Creates a new recent manager object.  Recent manager objects are used to
handle the list of recently used resources.  A #GtkRecentManager object
monitors the recently used resources list, and emits the "changed" signal
each time something inside the list changes.

#GtkRecentManager objects are expensive: be sure to create them only when
needed. You should use gtk_recent_manager_get_default() instead.</doc>
        <source-position filename="gtk+-2.24.33/gtk/gtkrecentmanager.h"
                         line="140"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="gtk+-2.24.33/gtk/gtkrecentmanager.c"
               line="775">A newly created #GtkRecentManager object.</doc>
          <type name="RecentManager" c:type="GtkRecentManager*"/>
        </return-value>
      </constructor>
      <function name="get_default"
                c:identifier="gtk_recent_manager_get_default"
                version="2.10">
        <doc xml:space="preserve"
             filename="gtk+-2.24.33/gtk/gtkrecentmanager.c"
             line="785">Gets a unique instance of #GtkRecentManager, that you can share
in your application without caring about memory management. The
returned instance will be freed when you application terminates.</doc>
        <source-position filename="gtk+-2.24.33/gtk/gtkrecentmanager.h"
                         line="141"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk+-2.24.33/gtk/gtkrecentmanager.c"
               line="792">A unique #GtkRecentManager. Do not ref or unref it.</doc>
          <type name="RecentManager" c:type="GtkRecentManager*"/>
        </return-value>
      </function>
      <function name="get_for_screen"
