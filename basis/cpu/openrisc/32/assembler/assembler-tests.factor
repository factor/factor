{ B{ 0xc0 0x00 0x58 0x14 } } [ [ R0 R11 0x14 MTSPR ] assemble ] unit-test
{ B{ 0xd4 0x01 0x10 0x00 } } [ [ R2 R1 0 SW ] assemble ] unit-test
{ B{ 0xe0 0x64 0x28 0x00 } } [ [ R3 R4 R5 ADD ] assemble ] unit-test
{ B{ 0xe0 0x03 0x23 0x07 } } [ [ R3 R4 MULD ] assemble ] unit-test
{ B{ 0xc8 0x65 0x38 0x10 } } [ [ F0 F1 F2 FADD.D ] assemble ] unit-test
{ B{ 0xb8 0xe7 0x00 0x04 } } [ [ R7 R7 4 SLLI ] assemble ] unit-test
{ B{ 0xb8 0xe7 0x00 0x44 } } [ [ R7 R7 4 SRLI ] assemble ] unit-test
{ B{ 0xb8 0xe7 0x00 0x84 } } [ [ R7 R7 4 SRAI ] assemble ] unit-test
