USING: cpu.openrisc.32.assembler cpu.openrisc.32.assembler.registers endian
kernel make sequences tools.test ;
IN: cpu.openrisc.32.assembler.tests

: assemble ( quot -- bytes ) B{ } make ; inline
: insn ( n -- bytes ) 4 >be ;

