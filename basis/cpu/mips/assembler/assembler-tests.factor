! Golden encodings independently checked with Zig LLVM MIPS64EL assembler.
USING: byte-arrays cpu.mips.assembler cpu.mips.assembler.registers
kernel make namespaces tools.test ;
IN: cpu.mips.assembler.tests

f mips-big-endian? [
{ B{ 0x21 0x10 0x85 0x00 } } [ [ V0 A0 A1 ADDU ] B{ } make ] unit-test
{ B{ 0x23 0x10 0x85 0x00 } } [ [ V0 A0 A1 SUBU ] B{ } make ] unit-test
{ B{ 0x85 0xff 0x82 0x24 } } [ [ V0 A0 -123 ADDIU ] B{ } make ] unit-test
{ B{ 0xc0 0x11 0x04 0x00 } } [ [ V0 A0 7 SLL ] B{ } make ] unit-test
{ B{ 0xfb 0xff 0x85 0x10 } } [ [ A0 A1 -20 BEQ ] B{ } make ] unit-test
{ B{ 0x09 0xf8 0x20 0x03 } } [ [ RA T9 JALR ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0xa2 0xdf } } [ [ V0 SP -16 LD ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0xa2 0xff } } [ [ V0 SP -16 SD ] B{ } make ] unit-test
{ B{ 0x2d 0x10 0x85 0x00 } } [ [ V0 A0 A1 DADDU ] B{ } make ] unit-test
{ B{ 0x00 0x10 0x24 0x46 } } [ [ F0 F2 F4 ADD.D ] B{ } make ] unit-test
{ B{ 0x08 0x00 0xe0 0x03 0x00 0x00 0x00 0x00 } } [ [ RET ] B{ } make ] unit-test
{ B{ 0 133 16 33 } } [ t mips-big-endian? [ [ V0 A0 A1 ADDU ] B{ } make ] with-variable ] unit-test
[ [ V0 A0 32768 ADDIU ] B{ } make ] must-fail
[ [ V0 A0 -32769 ADDIU ] B{ } make ] must-fail
[ [ V0 A0 65536 ORI ] B{ } make ] must-fail
[ [ V0 A0 32 SLL ] B{ } make ] must-fail
[ [ A0 A1 2 BEQ ] B{ } make ] must-fail
[ [ F0 A0 A1 ADDU ] B{ } make ] must-fail
{ B{ 0x18 0x00 0x85 0x00 } } [ [ A0 A1 MULT ] B{ } make ] unit-test
{ B{ 0x12 0x10 0x00 0x00 } } [ [ V0 MFLO ] B{ } make ] unit-test
{ B{ 0x1d 0x00 0x85 0x00 } } [ [ A0 A1 DMULTU ] B{ } make ] unit-test
{ B{ 0x04 0x10 0xa4 0x00 } } [ [ V0 A0 A1 SLLV ] B{ } make ] unit-test
{ B{ 0x01 0x00 0x81 0x04 } } [ [ A0 4 BGEZ ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0xa2 0xd7 } } [ [ F2 SP -16 LDC1 ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0xa2 0xf7 } } [ [ F2 SP -16 SDC1 ] B{ } make ] unit-test
{ B{ 0x00 0x20 0x22 0x44 } } [ [ V0 F4 DMFC1 ] B{ } make ] unit-test
{ B{ 0x00 0x20 0xa2 0x44 } } [ [ V0 F4 DMTC1 ] B{ } make ] unit-test
{ B{ 0x04 0x10 0x20 0x46 } } [ [ F0 F2 SQRT.D ] B{ } make ] unit-test
{ B{ 0x21 0x10 0x80 0x46 } } [ [ F0 F2 CVT.D.W ] B{ } make ] unit-test
{ B{ 0x0d 0x10 0x20 0x46 } } [ [ F0 F2 TRUNC.W.D ] B{ } make ] unit-test
{ B{ 0x34 0x12 0x19 0x3c 0x78 0x56 0x39 0x37 0x09 0xf8 0x20 0x03 0 0 0 0 } }
[ [ 0x12345678 CALL32 ] B{ } make ] unit-test
{ B{ 0xdc 0xfe 0x19 0x34 0x38 0xcc 0x19 0x00 0x98 0xba 0x39 0x37
     0x38 0xcc 0x19 0x00 0x54 0x76 0x39 0x37 0x38 0xcc 0x19 0x00
     0x10 0x32 0x39 0x37 0x09 0xf8 0x20 0x03 0 0 0 0 } }
[ [ 0xfedcba9876543210 CALL64 ] B{ } make ] unit-test
{ B{ 0x32 0x10 0x24 0x46 } } [ [ F2 F4 C.EQ.D ] B{ } make ] unit-test
{ B{ 0x3c 0x10 0x24 0x46 } } [ [ F2 F4 C.LT.D ] B{ } make ] unit-test
{ B{ 0x3e 0x10 0x24 0x46 } } [ [ F2 F4 C.LE.D ] B{ } make ] unit-test
{ B{ 0x31 0x10 0x24 0x46 } } [ [ F2 F4 C.UN.D ] B{ } make ] unit-test
{ B{ 0x01 0x00 0x01 0x45 } } [ [ 4 BC1T ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0xa2 0xc3 } } [ [ V0 SP -16 LL ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0xa2 0xe3 } } [ [ V0 SP -16 SC ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0xa2 0xd3 } } [ [ V0 SP -16 LLD ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0xa2 0xf3 } } [ [ V0 SP -16 SCD ] B{ } make ] unit-test
{ B{ 0x0a 0x10 0x85 0x00 } } [ [ V0 A0 A1 MOVZ ] B{ } make ] unit-test
{ B{ 0x0b 0x10 0x85 0x00 } } [ [ V0 A0 A1 MOVN ] B{ } make ] unit-test
{ B{ 0x0f 0x00 0x00 0x00 } } [ [ SYNC ] B{ } make ] unit-test
{ B{ 0x0d 0x00 0x00 0x00 } } [ [ BREAK ] B{ } make ] unit-test
{ B{ 0x0c 0x00 0x00 0x00 } } [ [ SYSCALL ] B{ } make ] unit-test
[ [ 2 BC1T ] B{ } make ] must-fail

{ B{ 0xf0 0xff 0x82 0x88 } } [ [ V0 A0 -16 LWL ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0x82 0x98 } } [ [ V0 A0 -16 LWR ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0x82 0xa8 } } [ [ V0 A0 -16 SWL ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0x82 0xb8 } } [ [ V0 A0 -16 SWR ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0x82 0x68 } } [ [ V0 A0 -16 LDL ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0x82 0x6c } } [ [ V0 A0 -16 LDR ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0x82 0xb0 } } [ [ V0 A0 -16 SDL ] B{ } make ] unit-test
{ B{ 0xf0 0xff 0x82 0xb4 } } [ [ V0 A0 -16 SDR ] B{ } make ] unit-test

! GNU as: cfc1 $8,$31 = 0x4448f800; ctc1 $8,$31 = 0x44c8f800.
{ B{ 0x00 0xf8 0x48 0x44 } } [ [ temp F31 CFC1 ] B{ } make ] unit-test
{ B{ 0x00 0xf8 0xc8 0x44 } } [ [ temp F31 CTC1 ] B{ } make ] unit-test

] with-variable
