! Checked against NetBSD 11.0/vax's native GNU assembler and objdump.
USING: byte-arrays cpu.vax.assembler kernel make tools.test ;
IN: cpu.vax.assembler.tests

{ B{ 0xd0 0x2a 0x50 0x04 } }
[ [ 42 LITERAL 0 R MOVL RET ] B{ } make ] unit-test
{ B{ 0xd0 0x8f 0x78 0x56 0x34 0x12 0x53 } }
[ [ 0x12345678 IMM.L 3 R MOVL ] B{ } make ] unit-test
{ B{ 0xd0 0xa9 0x0c 0x50 0xd0 0x50 0xa9 0xf4 } }
[ [ 9 12 MEM 0 R MOVL 0 R 9 -12 MEM MOVL ] B{ } make ] unit-test
{ B{ 0xc1 0x51 0x52 0x53 0xc3 0x51 0x52 0x53
     0xc5 0x51 0x52 0x53 0xc7 0x51 0x52 0x53 } }
[ [ 1 R 2 R 3 R ADDL3 1 R 2 R 3 R SUBL3
    1 R 2 R 3 R MULL3 1 R 2 R 3 R DIVL3 ] B{ } make ] unit-test
{ B{ 0xc9 0x51 0x52 0x53 0xcb 0x51 0x52 0x53 0xcd 0x51 0x52 0x53 } }
[ [ 1 R 2 R 3 R BISL3 1 R 2 R 3 R BICL3 1 R 2 R 3 R XORL3 ] B{ } make ] unit-test
{ B{ 0xd1 0x51 0x52 0x78 0x03 0x51 0x52 } }
[ [ 1 R 2 R CMPL 3 LITERAL 1 R 2 R ASHL ] B{ } make ] unit-test
{ B{ 0x16 0x9f 0x78 0x56 0x34 0x12 0x17 0x9f 0x78 0x56 0x34 0x12 } }
[ [ 0x12345678 JSB 0x12345678 JMP ] B{ } make ] unit-test
{ B{ 0xfb 0x01 0x9f 0x78 0x56 0x34 0x12 0x05 0x01 } }
[ [ 1 LITERAL 0x12345678 ABS CALLS RSB NOP ] B{ } make ] unit-test
{ B{ 0xdd 0x53 0xd0 0x8e 0x53 0xd0 0x53 0x7e } }
[ [ 3 R PUSHL 14 POSTINC 3 R MOVL 3 R 14 PREDEC MOVL ] B{ } make ] unit-test
{ B{ 0xd0 0xc9 0x00 0x01 0x50 0xd0 0xe9 0x00 0x00 0x01 0x00 0x50 } }
[ [ 9 256 MEM 0 R MOVL 9 65536 MEM 0 R MOVL ] B{ } make ] unit-test
{ B{ 0xd0 0x42 0x69 0x50 } }
[ [ 9 INDIRECT 2 INDEX 0 R MOVL ] B{ } make ] unit-test

{ B{ 0x8f 0xff 0xff 0xff 0xff } } [ -1 IMM.L ] unit-test
{ B{ 0x8f 0xff 0xff 0xff 0xff } } [ 0xffffffff IMM.L ] unit-test
{ B{ 0x8f 0x00 0x80 } } [ -32768 IMM.W ] unit-test
{ B{ 0x8f 0xff } } [ -1 IMM.B ] unit-test
{ B{ 0x69 } } [ 9 0 MEM ] unit-test
{ B{ 0xaf 0 } } [ 15 0 MEM ] unit-test
{ B{ 0xdc 0x7e 0xbb 0x8f 0xff 0x3f 0xba 0x8f 0xff 0x3f
     0xc0 0x04 0x5e 0xb9 0x0f 0xb8 0xae 0xfc
     0x16 0xaf 0 0x16 0x60 0x17 0x60 0x05 } }
[
    [ 14 PREDEC MOVPSL 0x3fff IMM.W PUSHR 0x3fff IMM.W POPR
      4 LITERAL 14 R ADDL2 15 LITERAL BICPSW 14 -4 MEM BISPSW
      15 0 MEM JSB* 0 INDIRECT JSB* 0 INDIRECT JMP* RSB ] B{ } make
] unit-test
{ B{ 0xa9 0x80 } } [ 9 -128 MEM ] unit-test
{ B{ 0xc9 0x7f 0xff } } [ 9 -129 MEM ] unit-test
{ B{ 0xc9 0xff 0x7f } } [ 9 32767 MEM ] unit-test
{ B{ 0xe9 0x00 0x80 0x00 0x00 } } [ 9 32768 MEM ] unit-test
{ B{ 0x11 0x80 0x13 0x7f } } [ [ -128 BRB 127 BEQL ] B{ } make ] unit-test

[ 16 R ] [ invalid-vax-register? ] must-fail-with
[ -1 R ] [ invalid-vax-register? ] must-fail-with
[ 9 INDIRECT 15 INDEX ] [ invalid-vax-register? ] must-fail-with
[ 64 LITERAL ] [ invalid-vax-immediate? ] must-fail-with
[ 0x100000000 IMM.L ] [ invalid-vax-immediate? ] must-fail-with
[ -0x80000001 IMM.L ] [ invalid-vax-immediate? ] must-fail-with
[ 9 0x80000000 MEM ] [ invalid-vax-immediate? ] must-fail-with
[ [ 128 BRB ] B{ } make ] [ invalid-vax-immediate? ] must-fail-with
