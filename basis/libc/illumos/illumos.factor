USING: alien.c-types alien.strings alien.syntax destructors kernel system ;
IN: libc

LIBRARY: libc

FUNCTION: int strerror_r ( int errno, char* buf, size_t buflen )

M: illumos strerror
    [
        1024 [ malloc &free ] keep [ strerror_r ] keepd nip
        alien>native-string
    ] with-destructors ;

CONSTANT: EPERM 1
CONSTANT: ENOENT 2
CONSTANT: ESRCH 3
CONSTANT: EINTR 4
