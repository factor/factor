USING: alien.c-types alien.syntax classes.struct unix.time unix.types ;
IN: unix.ffi
LIBRARY: libc
FUNCTION: int getgrouplist ( c-string user, gid_t group, gid_t* groups, int* count )
FUNCTION: int setgroups ( int count, gid_t* groups )
CONSTANT: MAXPATHLEN 1024
CONSTANT: FD_SETSIZE 1024
CONSTANT: EAI_SYSTEM 11
CONSTANT: F_GETFD 0x0002
CONSTANT: F_SETFD 0x0004
CONSTANT: F_GETFL 0x0008
CONSTANT: F_SETFL 0x0010
CONSTANT: F_GETLK 0x0020
CONSTANT: F_SETLK 0x0080
CONSTANT: F_SETLKW 0x0100
CONSTANT: FD_CLOEXEC 1
CONSTANT: O_RDONLY 0x0000
CONSTANT: O_WRONLY 0x0001
CONSTANT: O_RDWR 0x0002
CONSTANT: O_ACCMODE 0x0003
CONSTANT: O_EXCL 0x0100
CONSTANT: O_CREAT 0x0200
CONSTANT: O_TRUNC 0x0400
CONSTANT: O_NOCTTY 0x1000
CONSTANT: O_NOTRAVERSE 0x2000
CONSTANT: O_CLOEXEC 0x00000040
CONSTANT: O_NONBLOCK 0x00000080
CONSTANT: O_APPEND 0x00000800
CONSTANT: O_SYNC 0x00010000
CONSTANT: O_RSYNC 0x00020000
CONSTANT: O_DSYNC 0x00040000
CONSTANT: O_NOFOLLOW 0x00080000
CONSTANT: O_DIRECT 0x00100000
CONSTANT: O_DIRECTORY 0x00200000
CONSTANT: O_CLOFORK 0x00400000
CONSTANT: AF_UNSPEC 0
CONSTANT: AF_INET 1
CONSTANT: AF_APPLETALK 2
CONSTANT: AF_ROUTE 3
CONSTANT: AF_LINK 4
CONSTANT: AF_INET6 5
CONSTANT: AF_DLI 6
CONSTANT: AF_IPX 7
CONSTANT: AF_NOTIFY 8
CONSTANT: AF_LOCAL 9
CONSTANT: AF_BLUETOOTH 10
CONSTANT: AF_MAX 11
CONSTANT: SOCK_STREAM 1
CONSTANT: SOCK_DGRAM 2
CONSTANT: SOCK_RAW 3
CONSTANT: SOCK_SEQPACKET 5
CONSTANT: SOCK_MISC 255
CONSTANT: SOCK_NONBLOCK 0x00040000
CONSTANT: SOCK_CLOEXEC 0x00080000
CONSTANT: SOCK_CLOFORK 0x00100000
CONSTANT: SOL_SOCKET -1
CONSTANT: SO_ACCEPTCONN 0x00000001
CONSTANT: SO_BROADCAST 0x00000002
CONSTANT: SO_DEBUG 0x00000004
CONSTANT: SO_DONTROUTE 0x00000008
CONSTANT: SO_KEEPALIVE 0x00000010
CONSTANT: SO_OOBINLINE 0x00000020
CONSTANT: SO_REUSEADDR 0x00000040
CONSTANT: SO_REUSEPORT 0x00000080
CONSTANT: SO_USELOOPBACK 0x00000100
CONSTANT: SO_LINGER 0x00000200
CONSTANT: SO_SNDBUF 0x40000001
CONSTANT: SO_SNDLOWAT 0x40000002
CONSTANT: SO_SNDTIMEO 0x40000003
CONSTANT: SO_RCVBUF 0x40000004
CONSTANT: SO_RCVLOWAT 0x40000005
CONSTANT: SO_RCVTIMEO 0x40000006
CONSTANT: SO_ERROR 0x40000007
CONSTANT: SO_TYPE 0x40000008
CONSTANT: SO_NONBLOCK 0x40000009
CONSTANT: SO_BINDTODEVICE 0x4000000a
CONSTANT: SO_PEERCRED 0x4000000b
CONSTANT: AI_PASSIVE 0x00000001
CONSTANT: AI_CANONNAME 0x00000002
CONSTANT: AI_NUMERICHOST 0x00000004
CONSTANT: AI_NUMERICSERV 0x00000008
CONSTANT: AI_ALL 0x00000100
CONSTANT: AI_V4MAPPED_CFG 0x00000200
CONSTANT: AI_ADDRCONFIG 0x00000400
CONSTANT: AI_V4MAPPED 0x00000800
CONSTANT: EAI_ADDRFAMILY 1
CONSTANT: EAI_AGAIN 2
CONSTANT: EAI_BADFLAGS 3
CONSTANT: EAI_FAIL 4
CONSTANT: EAI_FAMILY 5
CONSTANT: EAI_MEMORY 6
CONSTANT: EAI_NODATA 7
CONSTANT: EAI_NONAME 8
CONSTANT: EAI_SERVICE 9
CONSTANT: EAI_SOCKTYPE 10
CONSTANT: EAI_BADHINTS 12
CONSTANT: EAI_PROTOCOL 13
CONSTANT: EAI_OVERFLOW 14
CONSTANT: EAI_MAX 15
ALIAS: O_NDELAY O_NONBLOCK
ALIAS: AF_UNIX AF_LOCAL
ALIAS: PF_UNSPEC AF_UNSPEC
ALIAS: PF_INET AF_INET
ALIAS: PF_INET6 AF_INET6
ALIAS: PF_UNIX AF_UNIX
CONSTANT: IPPROTO_TCP 6
CONSTANT: IPPROTO_UDP 17
STRUCT: sockaddr { sa_len uchar } { sa_family uchar } { sa_data uchar[30] } ;
STRUCT: sockaddr-in
    { len uchar } { family uchar } { port ushort }
    { addr in_addr_t } { unused char[24] } ;
STRUCT: sockaddr-in6
    { len uchar } { family uchar } { port ushort } { flowinfo uint }
    { addr uchar[16] } { scopeid uint } ;
CONSTANT: max-un-path 126
STRUCT: sockaddr-un { len uchar } { family uchar } { path char[126] } ;
STRUCT: addrinfo
    { flags int } { family int } { socktype int } { protocol int }
    { addrlen socklen_t } { canonname c-string } { addr void* } { next addrinfo* } ;
STRUCT: passwd
    { pw_name c-string } { pw_passwd c-string } { pw_uid uid_t } { pw_gid gid_t }
    { pw_dir c-string } { pw_shell c-string } { pw_gecos c-string } ;
! Native d_name is flexible at offset26; reserve NAME_MAX + terminator for readdir_r.
STRUCT: dirent
    { d_dev dev_t } { d_pdev dev_t } { d_ino ino_t } { d_pino ino_t }
    { d_reclen ushort } { d_name char[257] } ;
STRUCT: rlimit { cur rlim_t } { max rlim_t } ;
STRUCT: rusage
    { utime timeval } { stime timeval }
    { maxrss long } { ixrss long } { idrss long } { isrss long }
    { minflt long } { majflt long } { nswap long } { inblock long }
    { oublock long } { msgsnd long } { msgrcv long } { nsignals long }
    { nvcsw long } { nivcsw long } ;
