! Linux SPARC libc ABI, measured with GNU 32-bit and 64-bit target headers.
USING: kernel ;
IN: unix.ffi

CONSTANT: O_RDONLY 0
CONSTANT: O_WRONLY 1
CONSTANT: O_RDWR 2
CONSTANT: O_CREAT 512
CONSTANT: O_EXCL 2048
CONSTANT: O_NOCTTY 32768
CONSTANT: O_TRUNC 1024
CONSTANT: O_APPEND 8
CONSTANT: O_NONBLOCK 16384
CONSTANT: SOL_SOCKET 65535
CONSTANT: SO_DEBUG 1
CONSTANT: SO_REUSEADDR 4
CONSTANT: SO_TYPE 4104
CONSTANT: SO_ERROR 4103
CONSTANT: SO_DONTROUTE 16
CONSTANT: SO_BROADCAST 32
CONSTANT: SO_SNDBUF 4097
CONSTANT: SO_RCVBUF 4098
CONSTANT: SO_KEEPALIVE 8
CONSTANT: SO_OOBINLINE 256
CONSTANT: SO_SNDTIMEO 16384
CONSTANT: SO_RCVTIMEO 8192
CONSTANT: SOCK_STREAM 1
CONSTANT: SOCK_DGRAM 2
CONSTANT: SOCK_RAW 3
CONSTANT: O_NDELAY 16388
