Must Fail With: {
    [ "insert into foo (id) values('1');" sql-command ]
    [
        f drop [ sql-table-missing? ] 1 nkeep [ ] dip
        swap dup not
        [ drop 1 ndrop f ] [
            drop [ table>> "foo" = ] 1 nkeep [ ] dip
            swap dup not
            [ drop 1 ndrop f ] [ t [ 1 nnip ] [ no-cond ] if ]
            if
        ] if
    ]
}
Must Fail With: {
    [ "create table foo(id);" sql-command ]
    [
        f drop [ sql-table-exists? ] 1 nkeep [ ] dip
        swap dup not
        [ drop 1 ndrop f ] [
            drop [ table>> "foo" = ] 1 nkeep [ ] dip
            swap dup not
            [ drop 1 ndrop f ] [ t [ 1 nnip ] [ no-cond ] if ]
            if
        ] if
    ]
}
Must Fail With: {
    [ "create index main_index on foo(id);" sql-command ]
    [
        f drop [ sql-index-exists? ] 1 nkeep [ ] dip
        swap dup not
        [ drop 1 ndrop f ] [
            drop [ name>> "main_index" = ] 1 nkeep [ ] dip
            swap dup not
            [ drop 1 ndrop f ] [ t [ 1 nnip ] [ no-cond ] if ]
            if
        ] if
    ]
}
